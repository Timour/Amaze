<?xml version="1.0" encoding="UTF-8"?>
<shelfDocument>
  <!-- Ships and auto-registers, but the TAB is a per-machine add, lost
       on a Houdini upgrade (▸m/first-run). A shelf tool because a Python
       Panel action cannot take a hotkey; no default binding. ▸r/hotkeys -->

  <tool name="amaze_capture_hip" label="Capture"
        icon="$AMAZE/scripts/python/amaze/ui/icon_screenshot.svg">
    <helpText><![CDATA[Capture the current scene view as a thumbnail.]]></helpText>
    <script scriptType="python"><![CDATA[import hou

# The tool is rc_calls.capture(), which the suite runs. The sentence is
# messages.AMAZE_NOT_IMPORTABLE, copied for when Amaze itself cannot load.
try:
    from amaze.utils import rc_calls
except ImportError as exc:
    hou.ui.displayMessage(
        "Amaze is not importable from this session (%s).\n\n"
        "Check that $AMAZE points at the install and that Houdini was "
        "restarted after it changed." % exc)
else:
    rc_calls.capture()]]></script>
  </tool>

  <tool name="amaze_open_panel" label="Amaze"
        icon="$AMAZE/scripts/python/amaze/ui/logo_mark.svg">
    <helpText><![CDATA[Open Amaze in a floating window.]]></helpText>
    <script scriptType="python"><![CDATA[import hou

INTERFACE = "Amaze"

interface = hou.pypanel.interfaceByName(INTERFACE)
if interface is None:
    hou.ui.displayMessage(
        "The Amaze Python Panel interface is not installed.\n\n"
        "Check that $AMAZE points at the install (it supplies "
        "python_panels/Amaze.pypanel) and that Houdini was restarted "
        "after it changed.")
else:
    desktop = hou.ui.curDesktop()

    # python_panel_interface takes the interface NAME, never the object -
    # the object raises. The lookup above stays because it turns "not
    # installed" into a readable message, and the name form hides the
    # Python Panel toolbar.
    desktop.createFloatingPaneTab(
        hou.paneTabType.PythonPanel,
        size=(1100, 800),
        python_panel_interface=INTERFACE,
    )]]></script>
  </tool>

  <tool name="amaze_repair_library" label="Repair"
        icon="$AMAZE/scripts/python/amaze/ui/icon_repair.svg">
    <helpText><![CDATA[Check and repair the Amaze library. If Amaze is open, restart Houdini and run Repair before opening it again: an open Amaze keeps saving over the library and would wipe out whatever Repair fixed.]]></helpText>
    <script scriptType="python"><![CDATA[import hou

# Every check and sentence lives in the module. It must NOT import or
# construct the panel - Repair exists for when the panel will not open.
try:
    from amaze.dialogs import repair_dialog
    from amaze.utils import rc_calls
except ImportError as exc:
    hou.ui.displayMessage(
        "Amaze is not importable from this session (%s).\n\n"
        "Check that $AMAZE points at the install and that Houdini was "
        "restarted after it changed." % exc)
else:
    rc_calls.start()
    repair_dialog.run()]]></script>
  </tool>

  <tool name="amaze_check_updates" label="Updates"
        icon="$AMAZE/scripts/python/amaze/ui/icon_update.svg">
    <helpText><![CDATA[Check for a newer Amaze release and install it.]]></helpText>
    <script scriptType="python"><![CDATA[import hou

# The tool is rc_calls.check_for_updates(), which the suite runs. The sentence
# is messages.AMAZE_NOT_IMPORTABLE, copied for when Amaze itself cannot load.
try:
    from amaze.utils import rc_calls
except ImportError as exc:
    hou.ui.displayMessage(
        "Amaze is not importable from this session (%s).\n\n"
        "Check that $AMAZE points at the install and that Houdini was "
        "restarted after it changed." % exc)
else:
    rc_calls.check_for_updates()]]></script>
  </tool>

  <tool name="amaze_reload" label="Reload"
        icon="$AMAZE/scripts/python/amaze/ui/icon_reload.svg">
    <helpText><![CDATA[Install any new asset file from the packages on the Houdini path and reload the loaded ones, without restarting Houdini.]]></helpText>
    <script scriptType="python"><![CDATA[import hou

# The tool is rc_calls.reload_asset_files(), which the suite runs. The sentence
# is messages.AMAZE_NOT_IMPORTABLE, copied for when Amaze itself cannot load.
try:
    from amaze.utils import rc_calls
except ImportError as exc:
    hou.ui.displayMessage(
        "Amaze is not importable from this session (%s).\n\n"
        "Check that $AMAZE points at the install and that Houdini was "
        "restarted after it changed." % exc)
else:
    rc_calls.reload_asset_files()]]></script>
  </tool>

  <toolshelf name="amaze" label="Amaze">
    <memberTool name="amaze_open_panel"/>
    <memberTool name="amaze_capture_hip"/>
    <memberTool name="amaze_repair_library"/>
    <memberTool name="amaze_check_updates"/>
    <memberTool name="amaze_reload"/>
  </toolshelf>
</shelfDocument>
