<?xml version="1.0" encoding="UTF-8"?>
<shelfDocument>
  <!-- Ships and auto-registers, but the TAB is a per-machine add, lost
       on a Houdini upgrade (▸m/first-run). A shelf tool because a Python
       Panel action cannot take a hotkey; no default binding. ▸r/hotkeys -->

  <tool name="amaze_capture_hip" label="Capture"
        icon="$AMAZE/scripts/python/amaze/ui/icon_screenshot.svg">
    <helpText><![CDATA[Capture the current scene view as this scene's Amaze thumbnail.

Captures whatever the viewport is showing right now, and files it
under the scene that is currently open. The Amaze panel does not
need to be open.

Refuses, with a reason, when the viewport is rendering through a
pathtracing delegate - a capture runs a flipbook, and a flipbook
through Karma is work of unbounded size.]]></helpText>
    <script scriptType="python"><![CDATA[import hou

# The panel's button and this tool run the SAME function; every check
# and every refusal message lives there, so the two cannot drift.
try:
    from amaze.core import hip_library
except ImportError as exc:
    hou.ui.displayMessage(
        "Amaze is not importable from this session (%s).\n\n"
        "Check that $AMAZE points at the install and that Houdini was "
        "restarted after it changed." % exc)
else:
    try:
        hip_library.capture_open_scene()
    except hip_library.CaptureRefused as exc:
        hou.ui.displayMessage(str(exc))
    else:
        # basename() returns "untitled.hip" for an unsaved scene, never
        # "", so there is no empty case to defend against.
        hou.ui.setStatusMessage(
            "Amaze: thumbnail captured for %s" % hou.hipFile.basename())]]></script>
  </tool>

  <tool name="amaze_open_panel" label="Amaze"
        icon="$AMAZE/scripts/python/amaze/ui/logo_mark.svg">
    <helpText><![CDATA[Open Amaze in a floating window.

If a floating Amaze is already open this raises that one rather than
stacking a second copy.]]></helpText>
    <script scriptType="python"><![CDATA[import hou

INTERFACE = "Amaze"

interface = hou.pypanel.interfaceByName(INTERFACE)
if interface is None:
    hou.ui.displayMessage(
        "The Amaze Python Panel interface is not installed.\n\n"
        "Check that $AMAZE points at the install (it supplies "
        "python_panels/Amaze.pypanel) and that Houdini was restarted "
        "after it changed.")
else:
    desktop = hou.ui.curDesktop()

    # Already open? Raise it. Opening a second copy of a browser that
    # reads one library on disk is never what was wanted, and two of
    # them writing the same index is how a database gets damaged.
    #
    # paneTabs(), not floatingPaneTabs(): the first version scanned only
    # floating tabs, so an Amaze already open as a DOCKED tab was not
    # found and the tool opened a second copy - the exact hazard this
    # block exists to prevent. paneTabs() covers both.
    existing = None
    for tab in desktop.paneTabs():
        try:
            if tab.type() != hou.paneTabType.PythonPanel:
                continue
            active = tab.activeInterface()
            if active is not None and active.name() == INTERFACE:
                existing = tab
                break
        except Exception:
            continue

    if existing is not None:
        # All of this is best-effort and stays inside the try.
        # setIsCurrentTab is documented against "the containing pane",
        # and a tab made by createFloatingPaneTab has none
        # (PaneTab.pane() returns None there) - whether HOM no-ops or
        # raises is not documented, and a raise must not take the
        # raise-the-window path down with it.
        try:
            existing.setIsCurrentTab()
            panel = existing.floatingPanel()
            if panel is not None:
                window = panel.qtParentWindow()
                if window is not None:
                    window.raise_()
                    window.activateWindow()
        except Exception:
            pass
    else:
        # python_panel_interface takes the interface NAME, not the
        # hou.PythonPanelInterface object - passing the object raises
        # "argument 5 of type 'char const *'". interfaceByName above is
        # still worth doing: it turns "the panel is not installed" into
        # a readable message instead of a silent empty Python Panel.
        # Passing the name also hides the Python Panel toolbar, which is
        # what makes this read as an Amaze window rather than a host for
        # one.
        desktop.createFloatingPaneTab(
            hou.paneTabType.PythonPanel,
            size=(1100, 800),
            python_panel_interface=INTERFACE,
        )]]></script>
  </tool>

  <tool name="amaze_repair_library" label="Repair"
        icon="$AMAZE/scripts/python/amaze/ui/icon_repair.svg">
    <helpText><![CDATA[Check the Amaze library and put right what is wrong.

Reports which of the library's lists will not load, which files no
section accounts for, and what each saved copy of a list would bring
back. It can put a saved copy back, add unlisted files to a section,
and move unclaimed files aside into a dated folder inside the library.

It never deletes anything.

Run it before you open Amaze in this session. If Amaze has already been
open, quit Houdini and start it again first: an open Amaze saves the
library while you work and would write over anything Repair put back.
Repair always reports; it can only put things right from a Houdini that
has not opened the library yet.]]></helpText>
    <script scriptType="python"><![CDATA[import hou

# Every check, every refusal and every sentence lives in the module, so
# the tool cannot drift from what it reports. It deliberately does NOT
# import or construct the panel: Repair has to work when the panel will
# not open, which is the case it exists for.
try:
    from amaze.core import repair
except ImportError as exc:
    hou.ui.displayMessage(
        "Amaze is not importable from this session (%s).\n\n"
        "Check that $AMAZE points at the install and that Houdini was "
        "restarted after it changed." % exc)
else:
    repair.run()]]></script>
  </tool>

  <tool name="amaze_check_updates" label="Updates"
        icon="$AMAZE/scripts/python/amaze/ui/icon_update.svg">
    <helpText><![CDATA[Ask whether a newer Amaze has been released, and install it.

Asking changes nothing. If there is a newer release you are offered it,
and nothing is downloaded unless you choose Install Update. Until a
release is published this reports that there is none, which is not an
error.

Installing replaces this Amaze. Your library and your settings are not
touched, and nothing takes effect until Houdini restarts. Every previous
version stays on the releases page, so no copy is left on your disk.

Nothing is ever checked on its own - no launch-time check, no
background call. This tool and the button in Preferences are the only
things that ask.]]></helpText>
    <script scriptType="python"><![CDATA[import hou

# The verdict and its sentence live in the module, so the shelf tool
# and the Preferences button cannot say different things about the
# same answer.
try:
    from amaze.core import updater
except ImportError as exc:
    hou.ui.displayMessage(
        "Amaze is not importable from this session (%s).\n\n"
        "Check that $AMAZE points at the install and that Houdini was "
        "restarted after it changed." % exc)
else:
    from amaze import messages

    found = updater.check()
    if not found:
        # up-to-date, no release, or unreachable - the sentence is the
        # whole answer and there is nothing to offer.
        hou.ui.displayMessage(found.sentence, title=messages.TITLE_AMAZE)
    elif hou.ui.displayMessage(
            messages.UPDATE_OFFER % found.sentence,
            buttons=messages.BUTTONS_INSTALL_UPDATE,
            close_choice=1, title=messages.TITLE_AMAZE) == 0:
        try:
            updater.install(found)
        except OSError as exc:
            hou.ui.displayMessage(str(exc), title=messages.TITLE_AMAZE)   # the updater raises with a FINISHED sentence, shown as-is
        except Exception as exc:
            hou.ui.displayMessage(messages.UPDATE_FAILED_UNEXPECTED % exc,
                                  title=messages.TITLE_AMAZE)
        else:
            hou.ui.displayMessage(
                messages.UPDATE_INSTALLED % found.version,
                title=messages.TITLE_AMAZE)]]></script>
  </tool>

  <toolshelf name="amaze" label="Amaze">
    <memberTool name="amaze_open_panel"/>
    <memberTool name="amaze_capture_hip"/>
    <memberTool name="amaze_repair_library"/>
    <memberTool name="amaze_check_updates"/>
  </toolshelf>
</shelfDocument>
