#usda 1.0
(
    defaultPrim = "open_pbr_uber_base"
)

class "open_pbr_uber_base" (
        prepend apiSchemas = [
            "NodeGraphNodeAPI",
            "SemanticsLabelsAPI:material",
            "SemanticsLabelsAPI:vMaterial_Ver",
            "SemanticsLabelsAPI:PhysicalAI_SimReady_Materials_Ver",
            "SemanticsLabelsAPI:OpenPBR_Ver"
