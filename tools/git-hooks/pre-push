#!/bin/bash
# Refuse to push a red suite. That is ALL this does.
#
# This is the project's CI. Not GitHub Actions: the tests need hython,
# and a cloud runner has no Houdini licence. What CI actually buys you
# is "it cannot go unrun" - a hook buys that locally, in ~20 seconds.
# Wired with `git config core.hooksPath tools/git-hooks` so it travels
# with a clone (sync-install.sh re-wires it automatically).
#
# A push of UI files alone, from a terminal, runs the UI modules; any
# other push runs the whole suite.
#
# Escape hatch for a genuine emergency: git push --no-verify, or
# AMAZE_SKIP_TESTS=$(git rev-parse HEAD) git push - sha-bound so it
# cannot be exported once in a profile and disable the gate forever.

set -uo pipefail
repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

# The process gate runs first and lives in the private notes repo,
# like the personal-data gate the commit hooks run. Fail CLOSED when
# it is absent - a missing gate and a passing gate look identical
# from the outside otherwise.
gate="${AMAZE_PRIVATE_HOOKS:-$repo/../AmazeNotes/tools/git-hooks}/pre-push-gate"
if [ ! -x "$gate" ]; then
    echo "pre-push: REFUSED - the process gate is not installed, so" >&2
    echo "nothing is checking this push." >&2
    echo "  Looked for: $gate" >&2
    echo "  Clone the private notes repo beside this one, or point" >&2
    echo "  \$AMAZE_PRIVATE_HOOKS at the hooks it carries - INSTALL.md 6a." >&2
    echo "  Deliberate bypass: git push --no-verify" >&2
    exit 1
fi
"$gate" || exit 1

if [ "${AMAZE_SKIP_TESTS:-}" = "$(git rev-parse HEAD 2>/dev/null)" ]; then
    echo "pre-push: AMAZE_SKIP_TESTS matches HEAD - suite skipped" >&2
    echo "pre-push: DONE"
    exit 0
elif [ -n "${AMAZE_SKIP_TESTS:-}" ]; then
    echo "pre-push: AMAZE_SKIP_TESTS set but does not match HEAD - running anyway" >&2
fi

# UI MODULES - every module that asserts on the art or reads a UI file. Pinned
# by test_the_ui_modules_cover_every_module_that_reads_the_ui_files, so a new
# one cannot fall outside the short run silently.
UI_MODULES="test_hip_section test_notes test_tooltips test_ui_labels"

# Art, hover texts and the documents carry no logic, so a push of nothing else
# earns the UI modules instead of the whole suite. REFUSES TO SKIP ON ANY DOUBT:
# no refs, an unreadable range, a deletion, one path off the list, or a push
# with no terminal - the old skip logic put code on main while printing it skipped.
#
# A TTY IS THE TEST. The short run is for a person who just redrew a badge or
# reworded a label and can see the result; anything automated gets the whole
# gate, because automation is what pushes a range it did not look at.
ui_only=0
if [ -t 2 ]; then
    refs="$(cat)"
    if [ -n "$refs" ]; then
        ui_only=1
        while read -r _local_ref local_sha _remote_ref remote_sha; do
            [ -n "$local_sha" ] || continue
            case "$local_sha$remote_sha" in
                *[!0]*) ;;
                *) ui_only=0; break ;;
            esac
            if [ "$local_sha" = "0000000000000000000000000000000000000000" ] \
               || [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
                ui_only=0; break
            fi
            if ! changed="$(git diff --name-only \
                    "$remote_sha".."$local_sha" 2>/dev/null)"; then
                ui_only=0; break
            fi
            [ -n "$changed" ] || { ui_only=0; break; }
            while read -r path; do
                [ -n "$path" ] || continue
                case "$path" in
                    *.svg|scripts/python/amaze/ui/*.png) ;;
                    scripts/python/amaze/tooltips.py) ;;
                    MANUAL.md|README.md|CHANGELOG.md|docs/*) ;;
                    scripts/python/amaze/branding.py)    # the version bump a UI push needs, alone
                        if ! bump="$(git diff -U0 "$remote_sha".."$local_sha" -- "$path" \
                                | sed -n '/^@@/,$p' | grep '^[-+]')" \
                           || printf '%s\n' "$bump" \
                                | grep -qvE '^[-+]APP_VERSION = "[0-9]+\.[0-9]+\.[0-9]+"( .*)?$'; then
                            ui_only=0; break
                        fi ;;
                    *) ui_only=0; break ;;
                esac
            done <<< "$changed"
            [ "$ui_only" = 1 ] || break
        done <<< "$refs"
    fi
fi

# A git hook inherits almost no environment - resolve Houdini here.
# shellcheck source=tools/houdini-env.sh
. "$repo/tools/houdini-env.sh"
if ! command -v hython >/dev/null 2>&1 && [ -z "${HFS:-}" ]; then
    HFS="$(amaze_newest_houdini)"
    export HFS
fi
if ! command -v hython >/dev/null 2>&1 && [ ! -d "${HFS:-}" ]; then
    echo "PUSH REFUSED - no Houdini found, so the suite cannot run." >&2
    echo "  Set HFS to a Houdini install, or push with --no-verify." >&2
    exit 1
fi

# The figure is here so a long wait does not read as a hang, and it is
# DATED because it tracks the test count and nothing updates it: 130s was
# true at roughly half this many tests and understated the wait by 2x by
# the time anybody noticed. Re-measure when it misleads, and move the date.
if [ "$ui_only" = 1 ]; then
    echo "pre-push: UI only - running $UI_MODULES, not the whole suite"
    # shellcheck disable=SC2086
    output="$("$repo/scripts/python/amaze/tests/start_test.sh" $UI_MODULES 2>&1)"
else
    echo "pre-push: running the suite (minutes, not seconds - the Mac and the stick differ by 2.5x) ▸p/suite-timing"
    output="$("$repo/tools/run-tests.sh" 2>&1)"
fi
status=$?

tests_ran="$(printf '%s\n' "$output" | sed -n 's/^Ran \([0-9][0-9]*\) test.*/\1/p' | tail -1 || true)"
tests_ran="${tests_ran:-0}"
failed="$(printf '%s\n' "$output" | grep -cE '^FAILED( \(|$)' || true)"
leak="$(printf '%s\n' "$output" | grep -c 'LOG LEAK' || true)"

if [ "$status" -ne 0 ] || [ "$failed" -ne 0 ] || [ "$leak" -ne 0 ] \
   || [ "$tests_ran" -eq 0 ]; then
    echo >&2
    echo "PUSH REFUSED - the suite is not green." >&2
    printf '%s\n' "$output" | grep -E '^(FAIL|ERROR):|^FAILED|LOG LEAK|^Testing |^run-tests: ' | tail -25 >&2 || true
    echo >&2
    echo "  $tests_ran test(s) ran, $failed suite(s) failed. Fix, or push --no-verify." >&2
    exit 1
fi

echo "pre-push: $tests_ran tests OK, real debug log clean."
echo "pre-push: DONE"
exit 0
