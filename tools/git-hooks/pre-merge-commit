#!/bin/bash
# Runs the maintainer's checks, kept outside this repository, and refuses when it cannot find them.
# $AMAZE_PRIVATE_HOOKS overrides their location and is used as given, with no fallback.
set -uo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo="$(cd "$here/../.." && pwd)"
name="$(basename "${BASH_SOURCE[0]}")"
gate="${AMAZE_PRIVATE_HOOKS:-$repo/../AmazeNotes/tools/git-hooks}/$name"

if [ ! -x "$gate" ]; then
    echo "COMMIT REFUSED - the maintainer checks are not installed here." >&2
    echo "  They live outside this repository; this hook runs them when" >&2
    echo "  present and refuses when it cannot find them." >&2
    echo "  Looked for: $gate" >&2
    echo "  A contributor commits with --no-verify or leaves core.hooksPath unset." >&2
    echo "  Deliberate bypass: git commit --no-verify" >&2
    exit 1
fi

exec "$gate" "$@"
