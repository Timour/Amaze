<?xml version="1.0" encoding="UTF-8"?>
<pythonPanelDocument>
  <!-- This file contains definitions of Python interfaces and the
 interfaces menu.  It should not be hand-edited when it is being
 used by the application.  Note, that two definitions of the
 same interface or of the interfaces menu are not allowed
 in a single file. -->
  <!-- label = the pane-tab name, the ONE user-visible name Python cannot
       reach at load time - Houdini reads it before any code runs, so a
       rename is edited HERE to match branding.APP_NAME, and every saved
       .desk keyed on name= is patched in the same change. -->
  <interface name="Amaze" label="Amaze" icon="MISC_python" showNetworkNavigationBar="false"
    help_url="">
    <script><![CDATA[import os

from amaze.panel import panel

# Reload ONLY with the dev switch on - the import above already ran the
# module body, and reloading runs it and its whole chain again on every
# panel open. The live-test loop relaunches Houdini instead.
if os.environ.get("AMAZE_DEV_RELOAD"):
    import importlib
    importlib.reload(panel)


def onCreateInterface():
    amaze_widget = panel.MatLibPanel()
    return amaze_widget


# Houdini calls this when the tab becomes visible again. Coming back to
# Amaze is a door: without it, everything on screen is the copy read when
# the panel opened, so a colleague's new material or comment needs a
# Houdini restart to appear.
def onActivateInterface():
    from amaze.core import model_registry

    model_registry.refresh_all()]]></script>
    <includeInPaneTabMenu menu_position="99" create_separator="false" />
    <includeInToolbarMenu menu_position="415" create_separator="false" />
    <help><![CDATA[]]></help>
  </interface>
</pythonPanelDocument>
